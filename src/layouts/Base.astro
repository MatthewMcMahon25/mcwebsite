---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Matthew McMahon',
  description = 'Sound money, sovereign tools, and a life you own. The writing, the software, and the hardware I build — all in one place.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/favicon.png" type="image/png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand">Matthew <b>McMahon</b></a>
        <nav class="nav">
          <a class="navlink" href="/writing">Writing</a>
          <a class="navlink" href="/#the-work">The Work</a>
          <a class="navlink" href="/about">About</a>
          <a class="btn btn-gold" href="/#mcletter">The McLetter</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>© {new Date().getFullYear()} Matthew McMahon</span>
        <span>Play. Believe. Pursue.</span>
      </div>
    </footer>
  </body>
</html>
